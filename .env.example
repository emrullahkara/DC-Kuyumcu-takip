# DC Kuyumcu Takip — örnek ortam değişkenleri. Bu dosyayı .env olarak kopyalayın.
NODE_ENV=production
PORT=3000

# ZORUNLU (üretim): 32 baytlık rastgele anahtarlar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bu anahtarları kaybederseniz şifreli alanlar (TC no, 2FA) açılamaz — yedeğini güvenli saklayın.
DATA_ENCRYPTION_KEY=
INDEX_HMAC_KEY=

# İlk patron hesabının parolası (boş bırakılırsa rastgele üretilir ve data/ILK_GIRIS.txt dosyasına yazılır)
ADMIN_PASSWORD=

# HTTPS arkasında (nginx/Caddy) çalışırken
TRUST_PROXY=1
COOKIE_SECURE=true

# Oturum süreleri
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Canlı fiyat kaynağı (Türkçe "Alış/Satış" veya "Buying/Selling" biçimli JSON)
PRICE_URL=https://finans.truncgil.com/today.json
PRICE_REFRESH_SECONDS=60
# Tanıtım için sahte canlı fiyat üretir (gerçek kullanımda false)
PRICE_DEMO_SIMULATION=false
